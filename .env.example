# Copy to .env and set real values. Never commit .env.
# MongoDB Atlas → your cluster → Connect → Drivers → copy the SRV string.
# If the password has @, #, etc., URL-encode it in the connection string.
# Database name in the path must match Atlas (e.g. …mongodb.net/rashifal — same as in Atlas → Browse Collections).
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/rashifal?retryWrites=true&w=majority"

JWT_SECRET="change-me-to-a-long-random-string"

# Optional: in development, set to true to see full error text on 500 responses
# EXPOSE_INTERNAL_ERRORS=true
